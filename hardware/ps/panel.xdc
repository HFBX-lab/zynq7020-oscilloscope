# SP2 V1.3B J35; shared pin mapping with the legacy PL-only self-test.
create_clock -period 20.000 -name clk_50 [get_ports clk_50]
set_property -dict {PACKAGE_PIN M19 IOSTANDARD LVCMOS33} [get_ports clk_50]
set_property PACKAGE_PIN V7 [get_ports {lcd_r[0]}]
set_property PACKAGE_PIN AA12 [get_ports {lcd_r[1]}]
set_property PACKAGE_PIN AB7 [get_ports {lcd_r[2]}]
set_property PACKAGE_PIN AA8 [get_ports {lcd_r[3]}]
set_property PACKAGE_PIN U10 [get_ports {lcd_r[4]}]
set_property PACKAGE_PIN AB12 [get_ports {lcd_r[5]}]
set_property PACKAGE_PIN V10 [get_ports {lcd_r[6]}]
set_property PACKAGE_PIN Y4 [get_ports {lcd_r[7]}]
set_property PACKAGE_PIN AB9 [get_ports {lcd_g[0]}]
set_property PACKAGE_PIN V8 [get_ports {lcd_g[1]}]
set_property PACKAGE_PIN Y6 [get_ports {lcd_g[2]}]
set_property PACKAGE_PIN Y8 [get_ports {lcd_g[3]}]
set_property PACKAGE_PIN W8 [get_ports {lcd_g[4]}]
set_property PACKAGE_PIN Y9 [get_ports {lcd_g[5]}]
set_property PACKAGE_PIN AA9 [get_ports {lcd_g[6]}]
set_property PACKAGE_PIN AB10 [get_ports {lcd_g[7]}]
set_property PACKAGE_PIN Y5 [get_ports {lcd_b[0]}]
set_property PACKAGE_PIN V4 [get_ports {lcd_b[1]}]
set_property PACKAGE_PIN AA7 [get_ports {lcd_b[2]}]
set_property PACKAGE_PIN W7 [get_ports {lcd_b[3]}]
set_property PACKAGE_PIN AB6 [get_ports {lcd_b[4]}]
set_property PACKAGE_PIN AB4 [get_ports {lcd_b[5]}]
set_property PACKAGE_PIN AB5 [get_ports {lcd_b[6]}]
set_property PACKAGE_PIN W6 [get_ports {lcd_b[7]}]
set_property PACKAGE_PIN AA4 [get_ports lcd_clk]
set_property PACKAGE_PIN V9 [get_ports lcd_hsync]
set_property PACKAGE_PIN AB2 [get_ports lcd_vsync]
set_property PACKAGE_PIN AA6 [get_ports lcd_de]
set_property PACKAGE_PIN U7 [get_ports lcd_bl]
set_property PACKAGE_PIN W5 [get_ports lcd_reset_n]
set_property PACKAGE_PIN U6 [get_ports tp_reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports {lcd_* tp_*}]
set_property DRIVE 8 [get_ports {lcd_r[*] lcd_g[*] lcd_b[*] lcd_clk lcd_hsync lcd_vsync lcd_de}]
set_property SLEW SLOW [get_ports {lcd_r[*] lcd_g[*] lcd_b[*] lcd_clk lcd_hsync lcd_vsync lcd_de}]
create_generated_clock -name panel_clk -source [get_pins -hier -filter {NAME =~ */forward_clock/C}] -divide_by 1 -invert [get_ports lcd_clk]
# Candidate external budget; panel/FPC delays remain unmeasured.
set_output_delay -clock panel_clk -max 3.0 [get_ports {lcd_r[*] lcd_g[*] lcd_b[*] lcd_hsync lcd_vsync lcd_de}]
set_output_delay -clock panel_clk -min -1.0 [get_ports {lcd_r[*] lcd_g[*] lcd_b[*] lcd_hsync lcd_vsync lcd_de}]
set_false_path -to [get_ports {lcd_bl lcd_reset_n tp_reset_n}]
# Independent diagnostic bits enter a two-flop CDC synchronizer. Bound only the
# route to the FIRST stage; the stage1->stage2 settling path remains fully timed.
set status_inputs [get_pins -hier -filter {NAME =~ */status_cdc/inst/stage1_reg*/D}]
set_max_delay -datapath_only 10.000 -to $status_inputs
set_false_path -hold -to $status_inputs
