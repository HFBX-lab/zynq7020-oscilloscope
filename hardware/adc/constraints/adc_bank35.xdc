# CANDIDATE pin assignments only; choose ONE bank file.
# Post-adapter numbering from corrected user drawing. No power/NC ports.
# Not a complete timing constraint set or permission to program hardware.
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN D20} [get_ports {ad_clk_1}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN C17} [get_ports {ad_clk_2}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN G15} [get_ports {ad_data_1[0]}]
